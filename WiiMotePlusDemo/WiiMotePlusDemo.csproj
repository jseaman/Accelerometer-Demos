<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WiiMotePlusDemo</AssemblyName>
    <RootNamespace>WiiMotePlusDemo</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="vendor\**\*.cs" />
    <PackageReference Include="Raylib-cs" Version="8.0.0" />
    <ProjectReference Include="vendor\WiimoteLib\WiimoteCS\WiimoteLib\WiimoteLib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="wiimote.glb" Link="Assets\wiimote.glb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
