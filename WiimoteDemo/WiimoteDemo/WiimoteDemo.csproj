<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>Game.ico</ApplicationIcon>
    <RootNamespace>WiimoteDemo</RootNamespace>
    <AssemblyName>WiimoteDemo</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="WiimoteLib">
      <!-- WiimoteLib 1.7 patched for RVL-CNT-01-TR (VID 057e, PID 0330). -->
      <HintPath>..\libs\WiimoteLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The source FBX is version 6.1 (2009), unsupported by modern Assimp.
         Preserve the XNA-built content already supplied with the original demo. -->
    <Content Include="Content\Prebuilt\Models\*.xnb">
      <Link>Content\Models\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Content\Models\%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>
