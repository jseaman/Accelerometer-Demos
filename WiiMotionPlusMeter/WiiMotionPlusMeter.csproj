<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WiiMotionPlusMeter</AssemblyName>
    <RootNamespace>WiiMotionPlusMeter</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AquaGauge">
      <HintPath>libs\AquaGauge.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="WiimoteLib.MotionPlus">
      <HintPath>libs\WiimoteLib.MotionPlus.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
