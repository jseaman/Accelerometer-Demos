<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WiiMeter</RootNamespace>
    <AssemblyName>WiiMeter</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AquaGauge">
      <HintPath>..\libs\AquaGauge.dll</HintPath>
    </Reference>
    <Reference Include="WiimoteLib">
      <!-- Compatibility build accepting classic (PID 0306) and Plus/TR (PID 0330) remotes. -->
      <HintPath>..\libs\WiimoteLib.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
